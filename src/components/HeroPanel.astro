---
import enCopy from '../data/copy.en.json';
const { copy = enCopy } = Astro.props;
const h = copy.hero;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Emphasise currency amounts (e.g. $200, $26,000) in the subhead.
const subheadHtml = h.subhead.replace(
  /(\$\d[\d,]*(?:\.\d+)?|\d[\d,]*(?:\.\d+)?\$)/g,
  '<strong class="cc-subhead__amt">$1</strong>'
);
const u = h.cd_units || { days: 'Days', hours: 'Hours', minutes: 'Minutes', seconds: 'Seconds' };
---

<section class="cc-hero cc-hero--center" id="main">
  <!-- Section background image (candlestick arena). -->
  <div class="cc-hero__bg-img" aria-hidden="true">
    <picture>
      <source media="(max-width: 640px)" srcset={`${base}/hero-bg-mobile.webp`} type="image/webp" />
      <source media="(max-width: 640px)" srcset={`${base}/hero-bg-mobile.png`} type="image/png" />
      <source srcset={`${base}/hero-bg.webp`} type="image/webp" />
      <img src={`${base}/hero-bg.png`} alt="" loading="eager" decoding="async" />
    </picture>
  </div>
  <div class="cc-hero__bg-fx" aria-hidden="true"></div>
  <div class="cc-hero__bg-fade" aria-hidden="true"></div>

  <div class="cc-hero__center">
    <h1 class="cc-headline reveal" style="--reveal-delay: 120ms;">
      <span class="cc-headline__lead">{h.headline_lead}</span>
      <span class="cc-headline__amt">{h.headline_amount}<sup class="cc-headline__ast">*</sup></span>
    </h1>

    <p class="cc-headline-sub reveal" style="--reveal-delay: 180ms;">{h.headline_sub}</p>

    <p class="cc-subhead reveal" style="--reveal-delay: 220ms;" set:html={subheadHtml}></p>

    <!-- Countdown — bold centered tiles -->
    <div class="cc-cd2 reveal" style="--reveal-delay: 280ms;" data-countdown data-target={h.target_date}>
      <span class="cc-cd2__label">{h.countdown_label}</span>
      <div class="cc-cd2__tiles" role="timer" aria-live="polite">
        <div class="cc-cd2__tile">
          <span class="cc-cd2__num bt-num" data-d>00</span>
          <span class="cc-cd2__unit">{u.days}</span>
        </div>
        <div class="cc-cd2__tile">
          <span class="cc-cd2__num bt-num" data-h>00</span>
          <span class="cc-cd2__unit">{u.hours}</span>
        </div>
        <div class="cc-cd2__tile">
          <span class="cc-cd2__num bt-num" data-m>00</span>
          <span class="cc-cd2__unit">{u.minutes}</span>
        </div>
        <div class="cc-cd2__tile">
          <span class="cc-cd2__num bt-num" data-s>00</span>
          <span class="cc-cd2__unit">{u.seconds}</span>
        </div>
      </div>
    </div>

    <div class="cc-hero__cta-row reveal" style="--reveal-delay: 340ms;">
      <a href={h.cta_href} class="bt-btn bt-btn-primary cc-hero__cta" data-magnetic data-cta-track="landing" target="_blank" rel="noopener noreferrer">
        {h.cta}
      </a>
    </div>

    {h.cta_note && (
      <a href={`${base}${h.cta_note_href || '/terms'}`} class="cc-hero__cta-note reveal" style="--reveal-delay: 380ms;">
        {h.cta_note}
      </a>
    )}
  </div>
</section>

<script>
  import '../scripts/countdown.js';
  import '../scripts/magnetic.js';
</script>
