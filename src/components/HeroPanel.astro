---
import enCopy from '../data/copy.en.json';
const { copy = enCopy } = Astro.props;
const h = copy.hero;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Emphasise currency amounts (e.g. $200, $26,000) in the subhead.
const subheadHtml = h.subhead.replace(
  /(\$\d[\d,]*(?:\.\d+)?|\d[\d,]*(?:\.\d+)?\$)/g,
  '<strong class="cc-subhead__amt">$1</strong>'
);
const u = h.cd_units || { days: 'Days', hours: 'Hours', minutes: 'Minutes', seconds: 'Seconds' };
---

<section class="cc-hero" id="main">
  <!-- Full-bleed hero background: looping stadium video. The stadium image is
       the poster, so it shows immediately until the video can play (or if the
       video fails to load). -->
  <div class="cc-hero__bg-img" aria-hidden="true">
    <!-- Desktop / tablet: looping video (mp4 only fetched ≥641px). -->
    <video
      class="cc-hero__bg-video"
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      poster={`${base}/hero-stadium.png`}
    >
      <source src={`${base}/hero.mp4`} type="video/mp4" media="(min-width: 641px)" />
      <img src={`${base}/hero-stadium.png`} alt="" loading="eager" decoding="async" />
    </video>
    <!-- Mobile: looping portrait video (mp4 only fetched ≤640px). The portrait
         still is the poster — shows until the video plays / if it fails. -->
    <video
      class="cc-hero__bg-mobile"
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      poster={`${base}/hero-mobile.png`}
    >
      <source src={`${base}/hero-mobile.mp4`} type="video/mp4" media="(max-width: 640px)" />
      <img src={`${base}/hero-mobile.png`} alt="" loading="eager" decoding="async" />
    </video>
  </div>
  <!-- Subtle top scrim for headline legibility over the stands -->
  <div class="cc-hero__bg-fx" aria-hidden="true"></div>
  <!-- Bottom fade — blends the video into the page colour (anchored to the
       hero bottom, since the video is clipped there). -->
  <div class="cc-hero__bg-fade" aria-hidden="true"></div>

  <div class="cc-hero__grid">

    <!-- Top: $26,000! + sub + subhead.  Bottom: countdown + CTA (below the money). -->
    <div class="cc-hero__copy">
      <div class="cc-hero__copy-top">
        <h1 class="cc-headline cc-headline--prize reveal" style="--reveal-delay: 80ms;">
          <span class="cc-headline__amount bt-num" data-countup>{h.headline_amount}</span>
        </h1>

        <p class="cc-subhead reveal" style="--reveal-delay: 160ms;" set:html={subheadHtml}></p>
      </div>

      <div class="cc-hero__copy-bottom">
      <!-- Title for the countdown -->
      <p class="cc-headline-sub cc-headline-sub--cd reveal" style="--reveal-delay: 240ms;">
        {h.headline_sub}
      </p>

      <!-- Horizontal countdown STRIP — full-width, segmented -->
      <div class="cc-countdown cc-countdown--strip reveal" style="--reveal-delay: 260ms;" data-countdown data-target={h.target_date}>
        <div class="cc-countdown__row" role="timer" aria-live="polite">
          <div class="bt-cd">
            <span class="bt-cd-num bt-num" data-d>00</span>
            <span class="bt-cd-lbl">{u.days}</span>
          </div>
          <span class="bt-cd-sep" aria-hidden="true"></span>
          <div class="bt-cd">
            <span class="bt-cd-num bt-num" data-h>00</span>
            <span class="bt-cd-lbl">{u.hours}</span>
          </div>
          <span class="bt-cd-sep" aria-hidden="true"></span>
          <div class="bt-cd">
            <span class="bt-cd-num bt-num" data-m>00</span>
            <span class="bt-cd-lbl">{u.minutes}</span>
          </div>
          <span class="bt-cd-sep" aria-hidden="true"></span>
          <div class="bt-cd">
            <span class="bt-cd-num bt-num" data-s>00</span>
            <span class="bt-cd-lbl">{u.seconds}</span>
          </div>
        </div>
      </div>

      <div class="cc-hero__cta-row reveal" style="--reveal-delay: 320ms;">
        <a href={h.cta_href} class="bt-btn bt-btn-primary cc-hero__cta cc-hero__cta--xl" data-magnetic target="_blank" rel="noopener noreferrer">
          {h.cta}
        </a>
      </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/countdown.js';
  import '../scripts/magnetic.js';
</script>
