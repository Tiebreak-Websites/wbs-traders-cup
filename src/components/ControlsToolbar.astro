---
import enCopy from '../data/copy.en.json';
const { copy = enCopy, locale = copy?._meta?.locale || 'en' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = `${base}/`;
const logoSrc = `${base}/wbs-white.svg`;
---

<header class="cc-topbar" data-topbar aria-label="Site header">
  <div class="cc-topbar__inner">
    <a href={homeHref} class="cc-topbar__brand" aria-label="Warren Bowie & Smith">
      <img class="cc-topbar__logo" src={logoSrc} alt="Warren Bowie & Smith" width="160" height="48" />
    </a>
  </div>
</header>
