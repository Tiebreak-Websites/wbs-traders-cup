---
import enCopy from '../data/copy.en.json';
const { copy = enCopy, locale = copy?._meta?.locale || 'en' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = `${base}/`;
const logoSrc = `${base}/wbs-white.svg`;
const flagsBase = `${base}/flags`;
const h = copy.hero || {};
const c = copy.controls || {};
const languages = (c.languages && c.languages.length)
  ? c.languages
  : [
      { code: 'en', label: 'EN', name: 'English',   flag: 'globe' },
      { code: 'es', label: 'ES', name: 'Español',   flag: 'es' },
      { code: 'pt', label: 'PT', name: 'Português', flag: 'pt' },
    ];

const hrefFor = (code) => (code === 'en' ? `${base}/` : `${base}/${code}/`);
const current = languages.find((l) => l.code === locale) || languages[0];
---

<header class="cc-topbar" data-topbar aria-label="Site header">
  <div class="cc-topbar__inner">
    <a href={homeHref} class="cc-topbar__brand" aria-label="Warren Bowie & Smith">
      <img class="cc-topbar__logo" src={logoSrc} alt="Warren Bowie & Smith" width="160" height="48" />
    </a>

    <div class="cc-topbar__controls">
      {h.target_date && (
        <div class="cc-mini-cd" data-countdown data-target={h.target_date} aria-label="Time remaining">
          <span class="cc-mini-cd__live" aria-hidden="true"></span>
          <span class="cc-mini-cd__bracket" aria-hidden="true">[</span>
          <span class="cc-mini-cd__cell"><span data-d>00</span><i>d</i></span>
          <span class="cc-mini-cd__sep" aria-hidden="true">:</span>
          <span class="cc-mini-cd__cell"><span data-h>00</span><i>h</i></span>
          <span class="cc-mini-cd__sep" aria-hidden="true">:</span>
          <span class="cc-mini-cd__cell"><span data-m>00</span><i>m</i></span>
          <span class="cc-mini-cd__sep" aria-hidden="true">:</span>
          <span class="cc-mini-cd__cell"><span data-s>00</span><i>s</i></span>
          <span class="cc-mini-cd__bracket" aria-hidden="true">]</span>
        </div>
      )}

      <div class="cc-lang" data-lang-root>
        <button
          type="button"
          class="cc-lang__trigger"
          data-lang-trigger
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-label={c.language_label || 'Language'}
          lang={current.code}
        >
          <span class="cc-lang__flag" aria-hidden="true">
            {current.flag === 'globe' ? (
              <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="10" cy="10" r="7.6"/>
                <path d="M2.4 10h15.2M10 2.4c2.4 2.4 3.6 5 3.6 7.6s-1.2 5.2-3.6 7.6c-2.4-2.4-3.6-5-3.6-7.6S7.6 4.8 10 2.4z"/>
              </svg>
            ) : (
              <img src={`${flagsBase}/${current.flag}.svg`} alt="" width="20" height="14" />
            )}
          </span>
          <span class="cc-lang__code">{current.label}</span>
          <svg class="cc-lang__caret" aria-hidden="true" viewBox="0 0 12 12" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 4.5 L6 7.5 L9 4.5"/>
          </svg>
        </button>

        <ul class="cc-lang__menu" data-lang-menu role="listbox" aria-label={c.language_label || 'Language'} hidden>
          {languages.map((lang) => (
            <li role="presentation">
              <a
                href={hrefFor(lang.code)}
                class={`cc-lang__opt${lang.code === locale ? ' is-active' : ''}`}
                role="option"
                aria-selected={lang.code === locale ? 'true' : 'false'}
                hreflang={lang.code}
                lang={lang.code}
                data-lang-opt
              >
                <span class="cc-lang__flag" aria-hidden="true">
                  {lang.flag === 'globe' ? (
                    <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="10" cy="10" r="7.6"/>
                      <path d="M2.4 10h15.2M10 2.4c2.4 2.4 3.6 5 3.6 7.6s-1.2 5.2-3.6 7.6c-2.4-2.4-3.6-5-3.6-7.6S7.6 4.8 10 2.4z"/>
                    </svg>
                  ) : (
                    <img src={`${flagsBase}/${lang.flag}.svg`} alt="" width="20" height="14" loading="lazy" />
                  )}
                </span>
                <span class="cc-lang__opt-name">{lang.name}</span>
                <span class="cc-lang__opt-code" aria-hidden="true">{lang.label}</span>
                {lang.code === locale && (
                  <svg class="cc-lang__opt-check" aria-hidden="true" viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2.5 6.5 L5 9 L9.5 3.5"/>
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</header>

<style>
  /* Language selector — single button trigger + dropdown listbox. */
  .cc-lang { position: relative; display: inline-flex; }

  .cc-lang__trigger {
    appearance: none;
    -webkit-appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 10px 0 8px;
    border-radius: var(--bt-r-pill, 999px);
    background: var(--bt-bg-2, rgba(255, 255, 255, 0.04));
    border: 1px solid var(--bt-bg-line, rgba(255, 255, 255, 0.08));
    color: var(--bt-text-hi, #fff);
    font: inherit;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
    cursor: pointer;
    transition: background .15s ease, border-color .15s ease, box-shadow .15s ease;
  }
  .cc-lang__trigger:hover {
    background: var(--bt-bg-1, rgba(255, 255, 255, 0.06));
    border-color: rgba(255, 255, 255, 0.18);
  }
  .cc-lang__trigger:focus-visible {
    outline: none;
    border-color: var(--bt-accent, #FF861C);
    box-shadow: 0 0 0 2px rgba(255, 134, 28, 0.35);
  }
  .cc-lang.is-open .cc-lang__trigger {
    background: var(--bt-bg-1, rgba(255, 255, 255, 0.08));
    border-color: rgba(255, 255, 255, 0.22);
  }

  /* Flag chip: rounded rectangle with subtle hairline so light flags don't
     vanish into the dark topbar. SVG globe inherits currentColor. */
  .cc-lang__flag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 16px;
    border-radius: 3px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    color: var(--bt-text-mid, rgba(255, 255, 255, 0.7));
    flex: 0 0 auto;
  }
  .cc-lang__flag img,
  .cc-lang__flag svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cc-lang__flag svg { width: 14px; height: 14px; object-fit: unset; }

  .cc-lang__code { font-variant-numeric: tabular-nums; }
  .cc-lang__caret {
    color: var(--bt-text-dim, rgba(255, 255, 255, 0.6));
    transition: transform .18s ease;
  }
  .cc-lang.is-open .cc-lang__caret { transform: rotate(180deg); }

  /* Dropdown panel — flush-right under the trigger. */
  .cc-lang__menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 200px;
    margin: 0;
    padding: 6px;
    list-style: none;
    background: var(--bt-bg-1, #1c2429);
    border: 1px solid var(--bt-bg-line, rgba(255, 255, 255, 0.08));
    border-radius: 12px;
    box-shadow: 0 18px 40px -12px rgba(0, 0, 0, 0.55),
                0 4px 12px rgba(0, 0, 0, 0.25);
    z-index: 50;

    opacity: 0;
    transform: translateY(-4px) scale(0.98);
    transform-origin: top right;
    pointer-events: none;
    transition: opacity .14s ease, transform .14s ease;
  }
  .cc-lang.is-open .cc-lang__menu {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
  .cc-lang__menu[hidden] { display: none; }

  .cc-lang__opt {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--bt-text-mid, rgba(255, 255, 255, 0.78));
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1;
    transition: background .12s ease, color .12s ease;
  }
  .cc-lang__opt:hover,
  .cc-lang__opt:focus-visible {
    background: var(--bt-bg-2, rgba(255, 255, 255, 0.06));
    color: var(--bt-text-hi, #fff);
    outline: none;
  }
  .cc-lang__opt.is-active {
    color: var(--bt-text-hi, #fff);
    background: rgba(255, 134, 28, 0.12);
  }
  .cc-lang__opt-name { letter-spacing: 0.01em; }
  .cc-lang__opt-code {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--bt-text-dim, rgba(255, 255, 255, 0.5));
  }
  .cc-lang__opt.is-active .cc-lang__opt-code { color: var(--bt-accent, #FF861C); }
  .cc-lang__opt-check { color: var(--bt-accent, #FF861C); }

  @media (max-width: 640px) {
    .cc-lang__trigger { height: 32px; padding: 0 8px 0 6px; gap: 6px; font-size: 11px; }
    .cc-lang__flag { width: 20px; height: 14px; }
    .cc-lang__menu { min-width: 180px; }
  }
</style>

<script>
  (function () {
    // Topbar scroll state
    const bar = document.querySelector('[data-topbar]');
    if (bar) {
      let scheduled = false;
      let lastScrolled = null;
      const check = () => {
        scheduled = false;
        const scrolled = (window.scrollY || document.documentElement.scrollTop || 0) > 8;
        if (scrolled === lastScrolled) return;
        lastScrolled = scrolled;
        bar.classList.toggle('is-scrolled', scrolled);
      };
      const schedule = () => {
        if (scheduled) return;
        scheduled = true;
        setTimeout(check, 16);
      };
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      check();
    }

    // Language dropdown — click to toggle, outside-click + Esc to close.
    const root = document.querySelector('[data-lang-root]');
    if (!root) return;
    const trigger = root.querySelector('[data-lang-trigger]');
    const menu = root.querySelector('[data-lang-menu]');
    if (!trigger || !menu) return;

    const open = () => {
      root.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
      menu.removeAttribute('hidden');
    };
    const close = () => {
      root.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
      // delay hiding to let the fade-out animation finish
      setTimeout(() => {
        if (!root.classList.contains('is-open')) menu.setAttribute('hidden', '');
      }, 160);
    };
    const toggle = () => (root.classList.contains('is-open') ? close() : open());

    trigger.addEventListener('click', (e) => { e.stopPropagation(); toggle(); });
    document.addEventListener('click', (e) => {
      if (!root.contains(e.target)) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('is-open')) {
        close();
        trigger.focus();
      }
    });
  })();
</script>
