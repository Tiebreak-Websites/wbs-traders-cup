---
import enCopy from '../data/copy.en.json';
const { copy = enCopy } = Astro.props;
const locale = copy._meta?.locale === 'ar' ? 'ar' : 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const enHref = `${base}/`;
const arHref = `${base}/ar/`;
const logoSrc = `${base}/200invest-logo.svg`;
const h = copy.hero || {};
const isAr = locale === 'ar';
const dLbl = isAr ? 'ي' : 'd';
const hLbl = isAr ? 'س' : 'h';
const mLbl = isAr ? 'د' : 'm';
const sLbl = isAr ? 'ث' : 's';
---

<header class="cc-topbar" data-topbar aria-label="Site header">
  <a href={enHref} class="cc-topbar__brand" aria-label="200Invest">
    <img class="cc-topbar__logo" src={logoSrc} alt="200Invest" width="120" height="20" />
  </a>

  <div class="cc-topbar__controls">
    {h.target_date && (
      <div class="cc-mini-cd" data-countdown data-target={h.target_date} aria-label="Time remaining">
        <span class="cc-mini-cd__cell"><span data-d>00</span>{dLbl}</span>
        <span class="cc-mini-cd__sep" aria-hidden="true">:</span>
        <span class="cc-mini-cd__cell"><span data-h>00</span>{hLbl}</span>
        <span class="cc-mini-cd__sep" aria-hidden="true">:</span>
        <span class="cc-mini-cd__cell"><span data-m>00</span>{mLbl}</span>
        <span class="cc-mini-cd__sep" aria-hidden="true">:</span>
        <span class="cc-mini-cd__cell"><span data-s>00</span>{sLbl}</span>
      </div>
    )}

    <div class="cc-controls__lang" role="group" aria-label="Language">
      <a href={enHref} class={`cc-controls__lang-btn${locale === 'en' ? ' is-active' : ''}`} aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
      <a href={arHref} class={`cc-controls__lang-btn${locale === 'ar' ? ' is-active' : ''}`} aria-current={locale === 'ar' ? 'page' : undefined}>AR</a>
    </div>
  </div>
</header>

<script>
  // Reveal the fixed topbar once the user scrolls past the hero section.
  (function () {
    const bar = document.querySelector('[data-topbar]');
    const hero = document.querySelector('.cc-hero');
    if (!bar || !hero) return;

    let scheduled = false;
    let lastPast = null;
    function check() {
      scheduled = false;
      const rect = hero.getBoundingClientRect();
      // Show topbar when hero bottom has scrolled above the viewport top
      // (use small offset so it appears just before fully clearing)
      const past = rect.bottom < 32;
      if (past === lastPast) return;
      lastPast = past;
      bar.classList.toggle('is-visible', past);
      // Backstop: inline styles snap to the final state in environments where
      // CSS transitions don't tick (real browsers still animate smoothly).
      bar.style.transform = past ? 'translateY(0)' : 'translateY(-110%)';
      bar.style.opacity   = past ? '1' : '0';
      bar.style.pointerEvents = past ? 'auto' : 'none';
    }
    function schedule() {
      if (scheduled) return;
      scheduled = true;
      setTimeout(check, 16);
    }
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    check();
  })();
</script>
