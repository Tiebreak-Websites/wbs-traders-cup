---
import enCopy from '../data/copy.en.json';
const { copy = enCopy } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = `${base}/`;
const logoSrc = `${base}/wbs-white.svg`;
---

<header class="cc-topbar cc-topbar--static" aria-label="Site header">
  <a href={homeHref} class="cc-topbar__brand" aria-label="Warren Bowie & Smith">
    <img class="cc-topbar__logo" src={logoSrc} alt="Warren Bowie & Smith" width="172" height="52" />
  </a>
</header>
