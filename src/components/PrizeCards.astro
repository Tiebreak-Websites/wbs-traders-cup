---
import enCopy from '../data/copy.en.json';
const { copy = enCopy } = Astro.props;
const p = copy.prizes;
// Display order: 2nd / 1st / 3rd. Index in copy.prizes.items is [1st, 2nd, 3rd];
// bt-prize-pos--{N} controls visual order in the grid (1 = far-left, 2 = center, 3 = far-right).
const podiumOrder = [2, 1, 3];
const medal = ['gold', 'silver', 'bronze'];
const revealDelay = [440, 270, 120];
---

<section class="cc-prizes" id="prizes" aria-label={p.title}>
  <div class="cc-wrap">
    <!-- No section eyebrow or title — the prize amounts speak for themselves
         and have already been hinted at by the hero's prize-pool chip. -->
    <h2 class="sr-only">{p.title}</h2>

    <div class="cc-prizes__podium">
      {p.items.map((item, i) => {
        const isFirst = i === 0;
        return (
          <article
            class={`bt-prize bt-prize--${medal[i]} reveal bt-prize-pos--${podiumOrder[i]}${isFirst ? ' bt-prize--first' : ''}`}
            data-place={item.place}
            style={`--reveal-delay: ${revealDelay[i]}ms;`}
          >
            <span class="bt-prize__place-tag">{item.place} place</span>

            <div class="bt-prize__amount bt-num">
              <span class="bt-prize__amt-val" data-countup>{item.amount}</span>
            </div>

            {item.label && <div class="bt-prize__label">{item.label}</div>}
          </article>
        );
      })}
      <!-- Common podium base line connecting all three cards -->
      <span class="cc-prizes__base" aria-hidden="true"></span>
    </div>
  </div>
</section>

<script>
  import '../scripts/count-up.js';
</script>
