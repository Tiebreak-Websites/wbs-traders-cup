---
import enCopy from '../data/copy.en.json';
const { copy = enCopy } = Astro.props;
const p = copy.prizes;
const isAr = copy._meta?.locale === 'ar';
const championLabel = p.champion_label ?? (isAr ? 'البطل' : 'Champion');
const islamicLabel  = isAr ? 'شروط إسلامية' : 'Islamic terms';
const fundedLabel   = isAr ? 'حساب ممول'   : 'Funded account';
// JSON order: 1st, 2nd, 3rd. We assign podium order (2nd→left, 1st→center, 3rd→right)
// via CSS .bt-prize-pos--{N} on each card.
const podiumOrder = [2, 1, 3]; // matches the items array index order
---

<section class="cc-prizes" id="prizes">
  <div class="cc-wrap">
    <div class="cc-section-head cc-section-head--center reveal">
      <span class="bt-eyebrow">{p.eyebrow}</span>
      <h2 class="cc-section-title">{p.title}</h2>
      <p class="cc-section-sub">{p.subtitle}</p>
    </div>

    <div class="cc-prizes__grid">
      {p.items.map((item, i) => {
        const isFirst = i === 0;
        return (
          <article
            class={`bt-prize reveal bt-prize-pos--${podiumOrder[i]}${isFirst ? ' bt-prize--first' : ''}`}
            data-place={item.place}
            style={`--reveal-delay: ${(podiumOrder[i] - 1) * 120}ms;`}
          >
            <span class="bt-prize-marker" style={`color: ${item.color}`}></span>

            {isFirst && (
              <div class="bt-prize__crown" aria-hidden="true">
                <svg viewBox="0 0 32 24" fill="currentColor">
                  <path d="M2 6 L8 14 L16 4 L24 14 L30 6 L28 20 L4 20 Z" />
                  <circle cx="2" cy="6" r="2"/>
                  <circle cx="16" cy="4" r="2"/>
                  <circle cx="30" cy="6" r="2"/>
                </svg>
                <span class="bt-prize__champion">{championLabel}</span>
              </div>
            )}

            <div class="bt-prize__head">
              <span class={`bt-rank bt-rank-${i + 1}`}>{i + 1}</span>
              <span class="bt-label bt-prize__place">{item.place}{isAr ? '' : ' place'}</span>
            </div>

            <div class="bt-prize__amount bt-num">{item.amount}</div>
            {item.label && <div class="bt-prize__label">{item.label}</div>}

            <div class="bt-prize__divider"></div>

            <div class="bt-prize__badges">
              <span class="bt-chip bt-chip-halal">{islamicLabel}</span>
              <span class="bt-chip">{fundedLabel}</span>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .cc-section-sub {
    font-size: 15px;
    line-height: 1.55;
    color: var(--bt-text-mid);
    max-width: 640px;
    margin: 0;
  }
  .cc-section-head--center .cc-section-sub { margin: 0 auto; text-align: center; }

  /* Podium grid — 2 / 1 / 3 from left to right on desktop */
  .cc-prizes__grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr 1fr;
    gap: 20px;
    align-items: end;
    padding-top: 60px; /* room for the crown above 1st */
  }

  .bt-prize-pos--1 { order: 1; } /* left  — 2nd place */
  .bt-prize-pos--2 { order: 2; } /* center — 1st place */
  .bt-prize-pos--3 { order: 3; } /* right — 3rd place */

  /* First place — taller, elevated, gold border, stronger glow */
  .bt-prize--first {
    padding: 36px 30px 32px;
    border: 1px solid var(--bt-trophy);
    box-shadow:
      0 0 0 1px rgba(224, 184, 114, 0.18) inset,
      0 28px 60px -22px rgba(224, 184, 114, 0.40),
      0 0 0 6px rgba(224, 184, 114, 0.10);
    background: linear-gradient(180deg, rgba(224, 184, 114, 0.12) 0%, var(--bt-bg-1) 42%, rgba(224, 184, 114, 0.08) 100%);
    transform: translateY(-22px);
    position: relative;
    z-index: 1;
  }
  .bt-prize--first .bt-prize-marker {
    height: 4px;
    background: linear-gradient(90deg, var(--bt-trophy-100), var(--bt-trophy), var(--bt-trophy-deep), var(--bt-trophy));
  }
  .bt-prize--first .bt-prize__amount {
    color: #F1DA9C;
    font-size: 56px;
    text-shadow: 0 6px 22px rgba(224, 184, 114, 0.35);
  }
  .bt-prize--first .bt-prize__label { color: var(--bt-text-hi); font-weight: 700; }

  /* Crown + Champion label sitting above the 1st card */
  .bt-prize__crown {
    position: absolute;
    top: -56px;
    left: 50%;
    transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    color: var(--bt-trophy-deep);
    filter: drop-shadow(0 6px 14px rgba(201, 163, 90, 0.45));
  }
  .bt-prize__crown svg {
    width: 44px; height: 32px;
    fill: url(#cc-crown-grad);
  }
  .bt-prize__champion {
    display: inline-flex; align-items: center;
    padding: 4px 12px;
    border-radius: var(--bt-r-pill);
    background: linear-gradient(135deg, var(--bt-trophy-100), var(--bt-trophy-deep));
    color: #3A2A0A;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    box-shadow: 0 4px 10px -4px rgba(201,163,90,0.6);
  }

  /* 2nd and 3rd — slightly different visual to settle into podium hierarchy */
  .bt-prize__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }
  .bt-prize__place {
    color: var(--bt-text-dim);
    letter-spacing: 0.16em;
  }
  .bt-prize__amount {
    font-size: 44px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--bt-text-hi);
  }
  .bt-prize__label {
    margin-top: 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--bt-text-mid);
    letter-spacing: -0.005em;
  }
  .bt-prize__divider {
    height: 1px;
    background: var(--bt-bg-line);
    margin: 18px 0 14px;
  }
  .bt-prize--first .bt-prize__divider {
    background: linear-gradient(90deg, transparent, var(--bt-trophy-100), transparent);
  }
  .bt-prize__desc {
    font-size: 13px;
    line-height: 1.55;
    color: var(--bt-text-mid);
    margin: 0;
    min-height: 38px;
  }
  .bt-prize__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }

  /* RTL: keep podium order natural (2/1/3 reads right-to-left = 3-1-2 visually).
     For Arabic users we still want 2nd-left/1st-center/3rd-right so leave order. */

  @media (max-width: 960px) {
    .cc-prizes__grid {
      grid-template-columns: 1fr;
      padding-top: 64px;
      gap: 36px;
    }
    .bt-prize-pos--1, .bt-prize-pos--2, .bt-prize-pos--3 { order: unset; }
    /* Force 1st-place card on top on mobile */
    .bt-prize--first { order: -1; transform: translateY(0); }
    .bt-prize__amount { font-size: 40px; }
    .bt-prize--first .bt-prize__amount { font-size: 48px; }
  }
</style>

<!-- Crown gold gradient defined once in the page so the SVG can reference it -->
<svg width="0" height="0" style="position:absolute;width:0;height:0;overflow:hidden;" aria-hidden="true">
  <defs>
    <linearGradient id="cc-crown-grad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%"  stop-color="#F1DA9C"/>
      <stop offset="50%" stop-color="#E0B872"/>
      <stop offset="100%" stop-color="#C9A35A"/>
    </linearGradient>
  </defs>
</svg>
