---
import enCopy from '../data/copy.en.json';
const { copy = enCopy } = Astro.props;
const p = copy.prizes;
const tierKey = ['first', 'second', 'third'];
const revealDelay = [60, 140, 220];
---

<section class="cc-prizes" id="prizes" aria-label={p.title}>
  <div class="cc-wrap">
    <h2 class="sr-only">{p.title}</h2>

    <!-- Horizontal prize strip: 1st | 2nd | 3rd as three segments inside a
         single bordered container, hairline-divided. 1st gets a subtle orange
         wash + larger amount. Completely different from the podium layout. -->
    <div class="cc-prize-strip" role="list">
      {p.items.map((item, i) => (
        <article
          role="listitem"
          class={`cc-prize-strip__tier cc-prize-strip__tier--${tierKey[i]} reveal`}
          style={`--reveal-delay: ${revealDelay[i]}ms;`}
          data-place={item.place}
        >
          <span class="cc-prize-strip__rank">{item.place} place</span>
          <div class="cc-prize-strip__amt bt-num">
            <span data-countup>{item.amount}</span>
          </div>
          {item.label && <span class="cc-prize-strip__lbl">{item.label}</span>}
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import '../scripts/count-up.js';
</script>
