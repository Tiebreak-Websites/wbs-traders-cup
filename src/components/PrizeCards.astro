---
import enCopy from '../data/copy.en.json';
const { copy = enCopy } = Astro.props;
const p = copy.prizes;
const champion = p.items[0];
const runners = p.items.slice(1);
const runnerKey = ['second', 'third'];
const place = (item) => `${item.place} ${p.place_word || 'place'}`;
---

<section class="cc-prizes" id="prizes" aria-label={p.title}>
  <div class="cc-wrap">
    <div class="cc-section-head cc-section-head--center reveal">
      {p.eyebrow && <span class="bt-eyebrow">{p.eyebrow}</span>}
      <h2 class="cc-section-title">{p.title}</h2>
    </div>

    <!-- Featured-champion layout: a large 1st-place panel paired with a
         stacked column of runners-up. Deliberately asymmetric. -->
    <div class="cc-podium2" role="list">
      <article
        role="listitem"
        class="cc-podium2__champ reveal"
        style="--reveal-delay: 80ms;"
        data-place={champion.place}
      >
        <span class="cc-podium2__tag">{place(champion)}</span>
        <div class="cc-podium2__amt bt-num"><span data-countup>{champion.amount}</span></div>
        {champion.label && <span class="cc-podium2__lbl">{champion.label}</span>}
      </article>

      <div class="cc-podium2__rest">
        {runners.map((item, i) => (
          <article
            role="listitem"
            class={`cc-podium2__row cc-podium2__row--${runnerKey[i]} reveal`}
            style={`--reveal-delay: ${160 + i * 90}ms;`}
            data-place={item.place}
          >
            <span class="cc-podium2__tag">{place(item)}</span>
            <div class="cc-podium2__amt bt-num"><span data-countup>{item.amount}</span></div>
            {item.label && <span class="cc-podium2__lbl">{item.label}</span>}
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/count-up.js';
</script>
