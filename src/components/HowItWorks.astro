---
import enCopy from '../data/copy.en.json';
const { copy = enCopy } = Astro.props;
const h = copy.how_it_works;
const f = copy.formula;
const m = copy.mechanic || {};
// Formula equation: drive the rates from the mechanic data so the
// displayed equation stays in sync if the points formula changes.
const depositChunk = `$${m.points_per_200_deposit ? 200 : 200}`; // chunk size is $200 by spec
const ptsPerChunk = m.points_per_200_deposit ?? 10;
const ptsPerTrade = m.points_per_closed_trade ?? 5;
const finalWeekMult = m.final_week_multiplier ?? 2;
---

<section class="cc-how" id="how">
  <div class="cc-wrap">
    <div class="cc-section-head cc-section-head--center reveal">
      <span class="bt-eyebrow">{h.eyebrow}</span>
      <h2 class="cc-section-title">{h.title}</h2>
    </div>

    <!-- Stacked playbook rows — each step a full-width band with hanging
         step number on the left, stat + title + body to the right. -->
    <ol class="cc-how__steps" role="list">
      {h.steps.map((step, i) => (
        <li class="cc-how__step reveal" style={`--reveal-delay: ${i * 80}ms;`}>
          <div class="cc-how__step-num" aria-hidden="true">{step.n}</div>
          <div class="cc-how__step-meta">
            <span class="cc-how__step-stat">
              <strong>{step.stat}</strong>
              <i>{step.stat_label}</i>
            </span>
            <h3 class="cc-how__step-title">{step.t}</h3>
          </div>
          <p class="cc-how__step-desc">{step.d}</p>
        </li>
      ))}
    </ol>
  </div>

  {f && (
    <div class="cc-wrap cc-formula">
      <div class="cc-formula__head reveal">
        <span class="bt-eyebrow">{f.eyebrow}</span>
        <h3 class="cc-formula__title">{f.title}</h3>
      </div>

      <!-- Big bold equation — the formula spelled out in monospace, then a
           worked-example "calculator" panel below showing how it computes. -->
      <div class="cc-formula__equation reveal" style="--reveal-delay: 120ms;" aria-hidden="true">
        <span class="cc-eq__var">POINTS</span>
        <span class="cc-eq__op">=</span>
        <span class="cc-eq__group">
          <span class="cc-eq__term">
            <span class="cc-eq__term-num">DEPOSITS</span>
            <span class="cc-eq__term-div">/</span>
            <span class="cc-eq__term-num">{depositChunk}</span>
          </span>
          <span class="cc-eq__times">×</span>
          <span class="cc-eq__term-num cc-eq__num-accent">{ptsPerChunk}</span>
        </span>
        <span class="cc-eq__op">+</span>
        <span class="cc-eq__group">
          <span class="cc-eq__term-num">TRADES</span>
          <span class="cc-eq__times">×</span>
          <span class="cc-eq__term-num cc-eq__num-accent">{ptsPerTrade}</span>
        </span>
        <span class="cc-eq__op cc-eq__op--meta">[ × {finalWeekMult} in final week ]</span>
      </div>

      <!-- A two-pane "calc" — left lists the inputs, right shows the result -->
      <div class="cc-formula__calc reveal" style="--reveal-delay: 200ms;">
        <div class="cc-calc__inputs">
          <header class="cc-calc__h">
            <span class="bt-label">{f.example_label}</span>
            <span class="cc-calc__caption">{f.example_caption}</span>
          </header>
          <ul class="cc-calc__list">
            {f.example_inputs.map((input) => (
              <li class="cc-calc__row">
                <span class="cc-calc__row-lbl">{input.label}</span>
                <span class="cc-calc__row-val bt-num">{input.value}</span>
              </li>
            ))}
          </ul>
          <div class="cc-calc__breakdown">{f.example_breakdown}</div>
        </div>

        <div class="cc-calc__result">
          <span class="cc-calc__result-lbl">{copy.formula_calc?.result_label || f.example_unit || 'Champion Points'}</span>
          <div class="cc-calc__result-num bt-num">{f.example_value}</div>
          <span class="cc-calc__result-unit">{f.example_unit}</span>
        </div>
      </div>
    </div>
  )}
</section>
