---
import enCopy from '../data/copy.en.json';
const { copy = enCopy } = Astro.props;
const s = copy.leaderboard;
---

<section class="cc-leaderboard" id="leaderboard" aria-label={s.title}>
  <div class="cc-wrap">
    <h2 class="sr-only">{s.title}</h2>
    <div
      class="bt-card lb-card reveal"
      style="--reveal-delay: 120ms;"
      data-you-label={s.you_label}
      data-loading-text={s.loading_state}
      data-empty-text={s.empty_state}
      data-error-text={s.error_state}
      data-no-results-text={s.no_results}
      data-tickets-unit={s.tickets_unit || 'tickets'}
      data-updated-template={s.updated_ago_template || 'Updated {time} ago · refreshes every 30 sec'}
      data-seconds-short={s.seconds_short || 'sec'}
      data-minutes-short={s.minutes_short || 'min'}
      data-pagination-label={s.pagination_label || 'Leaderboard pagination'}
      data-prev-page-label={s.prev_page_label || 'Previous page'}
      data-next-page-label={s.next_page_label || 'Next page'}
      data-page-label-template={s.page_label_template || 'Page {n}'}
    >
      <header class="lb-card__head">
        <div class="lb-card__title-row">
          <h3 class="bt-h3 lb-card__title">{s.card_title}</h3>
        </div>
        <div class="lb-card__filters">
          <label class="lb-filter">
            <svg class="lb-filter__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.6"/>
              <line x1="11" y1="11" x2="14.5" y2="14.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            <input type="search" class="lb-filter__input" data-lb-filter-name placeholder={s.filter_name_placeholder} aria-label={s.filter_name_placeholder} autocomplete="off" />
          </label>
          <label class="lb-filter">
            <span class="lb-filter__hash" aria-hidden="true">#</span>
            <input type="search" class="lb-filter__input" data-lb-filter-id placeholder={s.filter_id_placeholder} aria-label={s.filter_id_placeholder} inputmode="numeric" autocomplete="off" />
          </label>
        </div>
      </header>

      <div class="lb-card__cols">
        <span>{s.columns.rank}</span>
        <span>{s.columns.trader}</span>
        <span class="lb-col--center">{s.columns.country}</span>
        <span class="lb-col--end">{s.columns.deposits}</span>
        <span class="lb-col--end">{s.columns.tickets}</span>
      </div>

      <div class="lb-card__rows" data-lb-body>
        <div class="lb-card__loading">{s.loading_state}</div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* Global so dynamically-rendered rows from leaderboard.js pick these up */
  .lb-card { padding: 20px; }

  .lb-card__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .lb-card__title-row { display: flex; align-items: center; gap: 12px; }
  .lb-card__title { color: var(--bt-text-hi); }

  /* Search filters (replace the old legend) */
  .lb-card__filters {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .lb-filter {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 0 12px;
    height: 36px;
    border-radius: var(--bt-r-pill);
    background: var(--bt-bg-2);
    border: 1px solid var(--bt-bg-line);
    color: var(--bt-text-dim);
    transition: border-color .15s ease, background .15s ease;
  }
  .lb-filter:focus-within {
    border-color: var(--bt-accent);
    background: var(--bt-bg-1);
  }
  .lb-filter__icon { width: 15px; height: 15px; flex: none; color: var(--bt-text-dim); }
  .lb-filter__hash { font-size: 14px; font-weight: 700; line-height: 1; color: var(--bt-text-dim); }
  .lb-filter__input {
    border: 0;
    background: transparent;
    outline: none;
    color: var(--bt-text-hi);
    font: inherit;
    font-size: 13px;
    width: 130px;
    max-width: 38vw;
    padding: 0;
  }
  .lb-filter__input::placeholder { color: var(--bt-text-dim); }
  .lb-filter__input[data-lb-filter-id] { width: 96px; font-family: var(--bt-num); }
  /* Remove native search clear/decorations for a consistent look */
  .lb-filter__input::-webkit-search-decoration,
  .lb-filter__input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; }

  /* Mobile: keep both search inputs on a single row, sharing the width */
  @media (max-width: 640px) {
    .lb-card__filters { flex-wrap: nowrap; width: 100%; gap: 6px; }
    .lb-filter { flex: 1 1 0; min-width: 0; padding: 0 10px; }
    .lb-filter__input,
    .lb-filter__input[data-lb-filter-id] { width: 100%; min-width: 0; max-width: none; }
  }

  .lb-card__cols {
    display: grid;
    grid-template-columns: var(--lb-cols);
    gap: var(--lb-gap);
    padding: 10px var(--lb-pad-x);
    padding-left: calc(var(--lb-pad-x) + 3px);
    color: var(--bt-text-dim);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .lb-col--end { justify-self: end; }
  .lb-col--center { justify-self: center; }

  .lb-card__rows { display: block; }

  .lb-card__loading,
  .lb-card__empty,
  .lb-card__error {
    padding: 44px 24px;
    text-align: center;
    color: var(--bt-text-mid);
    font-size: 14px;
  }
  .lb-card__error { color: var(--bt-down); }

  .lb-trader { color: var(--bt-text-hi); font-weight: 600; font-size: 14px; }
  .lb-trader-id { font-size: 11px; color: var(--bt-text-dim); letter-spacing: 0.04em; }
  .lb-trader-stack { display: flex; flex-direction: column; gap: 2px; }
  .lb-id {
    color: var(--bt-text-mid);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }
  .lb-you {
    margin-left: 8px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--bt-accent);
  }
  .lb-country {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    justify-self: center;
    gap: 8px;
    padding: 4px 10px 4px 6px;
    border-radius: var(--bt-r-pill);
    background: var(--bt-bg-2);
    border: 1px solid var(--bt-bg-line);
    color: var(--bt-text-mid);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1;
  }
  .lb-country__flag {
    display: block;
    width: 20px;
    height: 14px;
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgba(15, 22, 38, 0.08);
    object-fit: cover;
  }
  .lb-country__code {
    color: var(--bt-text);
    letter-spacing: 0.04em;
  }
  .lb-deposit { justify-self: end; color: var(--bt-text); font-weight: 500; font-size: 13px; }
  .lb-tickets {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--bt-text-hi);
    font-weight: 700;
    font-size: 16px;
  }
  .lb-ticket-ico {
    width: 22px;
    height: auto;
    flex: none;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.4));
  }
  .lb-tickets__unit {
    margin-left: 4px;
    font-size: 11px;
    font-weight: 600;
    color: var(--bt-text-dim);
  }
  html[dir="rtl"] .lb-tickets__unit { margin-left: 0; margin-right: 4px; }

  @media (max-width: 960px) {
    .lb-card__cols { display: none; }
  }
</style>

<script>
  import '../scripts/leaderboard.js';
</script>
