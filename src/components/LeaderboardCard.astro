---
import enCopy from '../data/copy.en.json';
const { copy = enCopy } = Astro.props;
const s = copy.leaderboard;
const ctaHref = copy.hero?.cta_href || '#';
---

<section class="cc-leaderboard cc-checker" id="check" aria-label={s.title}>
  <div class="cc-wrap">
    <div
      class="bt-card checker reveal"
      style="--reveal-delay: 120ms;"
      data-tickets-unit={s.tickets_unit || 'tickets'}
      data-deposit-label={s.deposit_label || 'Deposit'}
      data-tickets-label={s.tickets_label || 'Tickets'}
      data-found-msg={s.found_msg || "You're in the draw!"}
      data-not-found={s.not_found || "This ID doesn't have any tickets yet."}
      data-not-found-cta={s.not_found_cta || ''}
      data-checking={s.checking || 'Checking…'}
      data-error={s.error_state || "Couldn't check right now. Try again."}
      data-empty={s.input_required || 'Enter your account ID.'}
      data-cta-href={ctaHref}
    >
      <div class="checker__head">
        <h2 class="checker__title">{s.title}</h2>
        <p class="checker__sub">{s.subtitle}</p>
      </div>

      <form class="checker__form" data-checker-form novalidate>
        <input
          class="checker__input"
          data-checker-input
          type="text"
          autocomplete="off"
          placeholder={s.input_placeholder}
          aria-label={s.input_placeholder}
        />
        <button class="checker__btn" type="submit">{s.check_cta}</button>
      </form>

      <div class="checker__result" data-checker-result aria-live="polite"></div>
    </div>
  </div>
</section>

<style is:global>
  .checker { padding: clamp(24px, 4vw, 44px); width: 100%; margin: 0 auto; text-align: center; }

  .checker__head { margin-bottom: 22px; }
  .checker__title {
    font-family: var(--bt-font);
    font-weight: 800;
    font-size: clamp(24px, 3.2vw, 34px);
    letter-spacing: -0.02em;
    color: var(--bt-text-hi);
    margin: 0 0 8px;
  }
  .checker__sub {
    color: var(--bt-text-mid);
    font-size: 15px;
    line-height: 1.5;
    margin: 0 auto;
    max-width: none;
    text-align: center;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    /* too long for one line on small screens — let it wrap, stay centered */
    .checker__sub { white-space: normal; font-size: 14px; }
  }

  /* ID input + Check button — compact, centered within the full-width card */
  .checker__form {
    display: flex;
    gap: 10px;
    align-items: stretch;
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
  }
  .checker__input {
    flex: 1 1 auto;
    min-width: 0;
    height: 60px;
    padding: 0 20px;
    border-radius: var(--bt-r-sm, 12px);
    background: var(--bt-bg-2, rgba(255, 255, 255, 0.04));
    border: 1.5px solid var(--bt-bg-line, rgba(255, 255, 255, 0.12));
    color: var(--bt-text-hi, #fff);
    font: inherit;
    font-size: 18px;
    font-family: var(--bt-num, monospace);
    letter-spacing: 0.04em;
    text-align: center;
    outline: none;
    transition: border-color .15s ease, background .15s ease;
  }
  .checker__input::placeholder { color: var(--bt-text-dim); letter-spacing: 0; font-family: var(--bt-font); }
  .checker__input:focus { border-color: var(--bt-accent, #FF861C); background: var(--bt-bg-1); }

  /* .checker prefix keeps these above the `.bt button` global reset */
  .checker .checker__btn {
    flex: 0 0 auto;
    height: 60px;
    padding: 0 32px;
    border-radius: var(--bt-r-sm, 12px);
    background: var(--bt-accent, #FF861C);
    border: 0;
    color: #3A1C00;
    font: inherit;
    font-weight: 800;
    font-size: 17px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    cursor: pointer;
    transition: filter .15s ease, transform .15s ease;
  }
  .checker .checker__btn:hover { filter: brightness(1.06); }
  .checker .checker__btn:active { transform: translateY(1px); }
  /* After a check is run, the button switches to a neutral (non-orange) state;
     it returns to orange when the ID is edited. */
  .checker .checker__btn.is-checked {
    background: #2E3B43;
    color: #FFFFFF;
  }
  .checker .checker__btn.is-checked:hover { filter: brightness(1.12); }

  /* Result area — centered within the full-width card */
  .checker__result { margin: 22px auto 0; min-height: 8px; max-width: 760px; }
  .checker__result:empty { margin-top: 0; }

  .checker__checking { color: var(--bt-text-dim); font-size: 15px; padding: 14px; }

  /* Short inline validation error when the field is empty */
  .checker__hint {
    margin: 10px 0 0;
    color: var(--bt-down, #ff6b5e);
    font-size: 13.5px;
    font-weight: 600;
    text-align: center;
  }

  /* Not-found state */
  .checker__none {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 18px;
    padding: 20px 22px;
    border-radius: var(--bt-r-sm, 12px);
    background: var(--bt-bg-2, rgba(255, 255, 255, 0.03));
    border: 1px dashed var(--bt-bg-line-2, rgba(255, 255, 255, 0.16));
  }
  .checker__none p { margin: 0; color: var(--bt-text-mid); font-size: 16px; font-weight: 600; }
  .checker__none .checker__cta { flex: 0 0 auto; }
  .checker .checker__cta {
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding: 0 26px;
    border-radius: var(--bt-r-pill, 999px);
    background: var(--bt-accent, #FF861C);
    color: #3A1C00;
    font-weight: 800;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    text-decoration: none;
  }
  .checker .checker__cta:hover { filter: brightness(1.06); }

  /* Found state — an entry "ticket stub": status banner + info | ticket count */
  .checker__found {
    text-align: left;
    border-radius: var(--bt-r-sm, 14px);
    overflow: hidden;
    background:
      radial-gradient(140% 120% at 50% 0%, rgba(255, 134, 28, 0.14), transparent 55%),
      var(--bt-bg-1, rgba(255, 255, 255, 0.05));
    border: 1px solid var(--bt-accent-100, rgba(255, 134, 28, 0.40));
    box-shadow: 0 22px 50px -24px rgba(0, 0, 0, 0.66);
  }
  .checker__found-status {
    padding: 12px 16px;
    text-align: center;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--bt-accent, #FF861C);
    background: rgba(255, 134, 28, 0.13);
    border-bottom: 1px solid var(--bt-accent-100, rgba(255, 134, 28, 0.30));
  }
  .checker__stub {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: stretch;
  }
  .checker__stub-info {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px 22px;
    padding: 22px 24px;
  }
  .checker__person { display: flex; align-items: center; gap: 12px; }
  .checker__flag {
    width: 50px;
    height: 35px;
    border-radius: 4px;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.16);
    object-fit: cover;
    flex: 0 0 auto;
  }
  .checker__person-info { display: flex; flex-direction: column; align-items: flex-start; line-height: 1.2; }
  .checker__name { color: var(--bt-text-hi); font-weight: 700; font-size: 25px; }
  .checker__acct { color: var(--bt-text-dim); font-size: 13.5px; font-family: var(--bt-num); letter-spacing: 0.04em; }

  .checker__deposit { display: flex; flex-direction: column; gap: 4px; }
  .checker__deposit-lbl {
    font-size: 11px; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--bt-text-dim);
  }
  .checker__deposit-val { color: var(--bt-text-hi); font-weight: 800; font-size: 36px; line-height: 1; }

  /* Right "stub" — perforated divider + the big ticket count */
  .checker__stub-tickets {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-width: 150px;
    padding: 22px 28px;
    border-left: 2px dashed var(--bt-bg-line-2, rgba(255, 255, 255, 0.20));
    background: rgba(255, 134, 28, 0.06);
  }
  .checker__tic-ico { width: 56px; height: auto; filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.45)); }
  .checker__tickets-num {
    font-weight: 800;
    font-size: clamp(46px, 8vw, 62px);
    line-height: 1;
    color: #FF9D2E;
    text-shadow: 0 0 22px rgba(255, 134, 28, 0.40);
  }
  .checker__tickets-lbl {
    font-size: 11px; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--bt-text-dim);
  }

  @media (max-width: 560px) {
    .checker__form { flex-direction: column; }
    .checker .checker__btn { height: 54px; }
    .checker__stub { grid-template-columns: 1fr; }
    /* Mobile: stack; deposit + tickets centred, but the user (flag + name + id)
       aligned to the left. */
    .checker__stub-info { flex-direction: column; align-items: center; text-align: center; }
    .checker__person { align-self: stretch; justify-content: flex-start; }
    .checker__person-info { align-items: flex-start; text-align: left; }
    .checker__deposit { align-items: center; }
    .checker__stub-tickets {
      border-left: 0;
      border-top: 2px dashed var(--bt-bg-line-2, rgba(255, 255, 255, 0.20));
      /* Mobile: icon + number + "tickets" on a single row */
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 4px 10px;
    }
    .checker__stub-tickets .checker__tickets-lbl { align-self: center; }
  }
</style>

<script>
  import '../scripts/leaderboard.js';
</script>
