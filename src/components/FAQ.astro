---
import enCopy from '../data/copy.en.json';
const { copy = enCopy } = Astro.props;
const f = copy.faq;
const compliance = copy.compliance;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const logoSrc = `${base}/wbs-white.svg`;
---

<section class="cc-faq">
  <div class="cc-wrap cc-faq__wrap">
    <div class="cc-section-head cc-section-head--center reveal">
      <span class="bt-eyebrow">{f.eyebrow}</span>
      <h2 class="cc-section-title">{f.title}</h2>
    </div>

    <div class="cc-faq__list cc-faq__grid" data-faq-list>
      {f.items.map((item, i) => (
        <div class={`cc-faq__item reveal${i === 0 ? ' is-open' : ''}`} style={`--reveal-delay: ${i * 60}ms;`} data-faq-item>
          <button class="cc-faq__head" data-faq-toggle aria-expanded={i === 0 ? 'true' : 'false'}>
            <span class="cc-faq__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="cc-faq__q">{item.t}</span>
            <span class="cc-faq__icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 6 l4 4 l4 -4" />
              </svg>
            </span>
          </button>
          <div class="cc-faq__panel">
            <div class="cc-faq__body">{item.d}</div>
          </div>
        </div>
      ))}
    </div>

    <div class="cc-faq__footer">
      <img class="cc-faq__logo reveal" src={logoSrc} alt="Warren Bowie & Smith" width="150" height="45" loading="lazy" />
      <p class="cc-faq__compliance reveal">{compliance}</p>
    </div>
  </div>
</section>

<script>
  // Single-open accordion behaviour (matches the design prototype).
  const items = document.querySelectorAll('[data-faq-item]');
  items.forEach((item) => {
    const btn = item.querySelector('[data-faq-toggle]');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const isOpen = item.classList.contains('is-open');
      items.forEach((el) => {
        el.classList.remove('is-open');
        const b = el.querySelector('[data-faq-toggle]');
        if (b) b.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
