---
import enCopy from '../data/copy.en.json';
const { copy = enCopy } = Astro.props;
const f = copy.faq;
const compliance = copy.compliance;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const logoSrc = `${base}/wbs-white.svg`;

// Footer language switcher (moved here from the top bar).
const locale = copy?._meta?.locale || 'en';
const c = copy.controls || {};
const languages = (c.languages && c.languages.length)
  ? c.languages
  : [
      { code: 'en', label: 'EN', name: 'English',   flag: 'gb' },
      { code: 'es', label: 'ES', name: 'Español',   flag: 'es' },
      { code: 'pt', label: 'PT', name: 'Português', flag: 'pt' },
    ];
const flagsBase = `${base}/flags`;
const langHref = (code) => (code === 'en' ? `${base}/` : `${base}/${code}/`);
---

<section class="cc-faq">
  <div class="cc-wrap cc-faq__wrap">
    <div class="cc-section-head cc-section-head--center reveal">
      <span class="bt-eyebrow">{f.eyebrow}</span>
      <h2 class="cc-section-title">{f.title}</h2>
    </div>

    <div class="cc-faq__list" data-faq-list>
      {f.items.map((item, i) => (
        <div class={`cc-faq__item reveal${i === 0 ? ' is-open' : ''}`} style={`--reveal-delay: ${i * 60}ms;`} data-faq-item>
          <button class="cc-faq__head" data-faq-toggle aria-expanded={i === 0 ? 'true' : 'false'}>
            <span class="cc-faq__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="cc-faq__q">{item.t}</span>
            <span class="cc-faq__icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 6 l4 4 l4 -4" />
              </svg>
            </span>
          </button>
          <div class="cc-faq__panel">
            <div class="cc-faq__body">{item.d}</div>
          </div>
        </div>
      ))}
    </div>

    <div class="cc-faq__footer">
      <img class="cc-faq__logo reveal" src={logoSrc} alt="Warren Bowie & Smith" width="188" height="56" loading="lazy" />

      <nav class="cc-foot-lang reveal" aria-label={c.language_label || 'Language'}>
        {languages.map((lang) => (
          <a
            href={langHref(lang.code)}
            class={`cc-foot-lang__opt${lang.code === locale ? ' is-active' : ''}`}
            hreflang={lang.code}
            lang={lang.code}
            aria-current={lang.code === locale ? 'true' : 'false'}
          >
            <img class="cc-foot-lang__flag" src={`${flagsBase}/${lang.flag}.svg`} alt="" width="20" height="14" loading="lazy" />
            <span>{lang.name}</span>
          </a>
        ))}
      </nav>

      <p class="cc-faq__compliance reveal">{compliance}</p>
    </div>

    <style>
      .cc-foot-lang {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px;
        margin: 4px 0 18px;
      }
      .cc-foot-lang__opt {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 14px;
        border-radius: var(--bt-r-pill, 999px);
        background: var(--bt-bg-2, rgba(255, 255, 255, 0.04));
        border: 1px solid var(--bt-bg-line, rgba(255, 255, 255, 0.08));
        color: var(--bt-text-mid, rgba(255, 255, 255, 0.7));
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: background .15s ease, border-color .15s ease, color .15s ease;
      }
      .cc-foot-lang__opt:hover { color: var(--bt-text-hi, #fff); border-color: rgba(255, 255, 255, 0.2); }
      .cc-foot-lang__opt.is-active {
        color: var(--bt-text-hi, #fff);
        border-color: var(--bt-accent, #FF861C);
        background: rgba(255, 134, 28, 0.12);
      }
      .cc-foot-lang__flag {
        width: 20px;
        height: 14px;
        border-radius: 2px;
        box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12);
        object-fit: cover;
      }
    </style>
  </div>
</section>

<script>
  // Single-open accordion behaviour (matches the design prototype).
  const items = document.querySelectorAll('[data-faq-item]');
  items.forEach((item) => {
    const btn = item.querySelector('[data-faq-toggle]');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const isOpen = item.classList.contains('is-open');
      items.forEach((el) => {
        el.classList.remove('is-open');
        const b = el.querySelector('[data-faq-toggle]');
        if (b) b.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
