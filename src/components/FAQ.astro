---
import enCopy from '../data/copy.en.json';
const { copy = enCopy } = Astro.props;
const f = copy.faq;
const compliance = copy.compliance;
const legal = copy.legal;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const logoSrc = `${base}/wbs-white.svg`;
const items = f.items || [];
---

<section class="cc-faq">
  <div class="cc-wrap cc-faq__wrap">
    <div class="cc-section-head cc-section-head--center reveal">
      <span class="bt-eyebrow">{f.eyebrow}</span>
      <h2 class="cc-section-title">{f.title}</h2>
    </div>

    <!-- Two-pane help center: question list (left) + answer panel (right) -->
    <div class="cc-faq2 reveal" data-faq2>
      <div class="cc-faq2__list" role="tablist" aria-label={f.title}>
        {items.map((item, i) => (
          <button
            type="button"
            class={`cc-faq2__q${i === 0 ? ' is-active' : ''}`}
            role="tab"
            id={`faq2-q-${i}`}
            aria-controls="faq2-panel"
            aria-selected={i === 0 ? 'true' : 'false'}
            data-faq2-q={i}
          >
            <span class="cc-faq2__q-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="cc-faq2__q-text">{item.t}</span>
            <svg class="cc-faq2__q-arrow" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 3 l5 5 l-5 5" />
            </svg>
          </button>
        ))}
      </div>

      <div class="cc-faq2__panel" id="faq2-panel" role="tabpanel" aria-live="polite">
        {items.map((item, i) => (
          <article class={`cc-faq2__answer${i === 0 ? ' is-active' : ''}`} data-faq2-a={i} aria-labelledby={`faq2-q-${i}`}>
            <span class="cc-faq2__answer-tag" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="cc-faq2__answer-q">{item.t}</h3>
            <p class="cc-faq2__answer-d">{item.d}</p>
          </article>
        ))}
      </div>
    </div>

    <div class="cc-faq__footer">
      <img class="cc-faq__logo reveal" src={logoSrc} alt="Warren Bowie & Smith" width="188" height="56" loading="lazy" />
      {legal?.website_terms_href && (
        <p class="cc-faq__legal reveal">
          <a class="cc-faq__legal-link" href={`${base}${legal.website_terms_href}`} target="_blank" rel="noopener noreferrer">
            {legal.website_terms_label}
          </a>
        </p>
      )}
      <p class="cc-faq__compliance reveal">{compliance}</p>
    </div>
  </div>
</section>

<script>
  // Two-pane help center: selecting a question shows its answer in the panel.
  const root = document.querySelector('[data-faq2]');
  if (root) {
    const questions = Array.from(root.querySelectorAll('[data-faq2-q]'));
    const answers = Array.from(root.querySelectorAll('[data-faq2-a]'));
    const isMobile = () => window.matchMedia('(max-width: 760px)').matches;

    function select(idx) {
      questions.forEach((q) => {
        const on = q.getAttribute('data-faq2-q') === String(idx);
        q.classList.toggle('is-active', on);
        q.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      answers.forEach((a) => {
        a.classList.toggle('is-active', a.getAttribute('data-faq2-a') === String(idx));
      });
    }

    questions.forEach((q) => {
      q.addEventListener('click', () => {
        const idx = q.getAttribute('data-faq2-q');
        select(idx);
        // On mobile the panel sits below the list — bring the answer into view.
        if (isMobile()) {
          const ans = root.querySelector(`[data-faq2-a="${idx}"]`);
          if (ans) ans.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    });
  }
</script>
