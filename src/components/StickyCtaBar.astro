---
import enCopy from '../data/copy.en.json';
const { copy = enCopy } = Astro.props;
const s = copy.sticky_cta;
---

<a href={s.cta_href}
   class="cc-fab is-hidden"
   data-sticky
   target="_blank"
   rel="noopener noreferrer"
   aria-label={s.cta}>
  <span class="cc-fab__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 12h14M13 6l6 6-6 6"/>
    </svg>
  </span>
  <span class="cc-fab__label">{s.cta}</span>
</a>

<script>
  // Reveal after user scrolls past hero (300px), hide back at very top.
  const fab = document.querySelector('[data-sticky]');
  if (fab) {
    const onScroll = () => {
      const past = window.scrollY > 320;
      fab.classList.toggle('is-hidden', !past);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
