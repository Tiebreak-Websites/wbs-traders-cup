---
// Termos e Condições do Torneio — Português
// Conteúdo traduzido do arquivo oficial em inglês (a versão em inglês prevalece).
import BaseLayout      from '../../layouts/BaseLayout.astro';
import ControlsToolbar from '../../components/ControlsToolbar.astro';
import copy from '../../data/copy.pt.json';
import termsBody from '../../content/terms-pt.html?raw';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageTitle = 'Termos e Condições da Traders Cup Verão 2026 da Warren Bowie & Smith';
---

<BaseLayout copy={copy} locale="pt" title={pageTitle} description="Termos e condições oficiais da Traders Cup Verão 2026 da Warren Bowie & Smith.">
  <div class="bt cc-page">
    <ControlsToolbar copy={copy} locale="pt" />

    <main class="cc-main">
      <article class="cc-legal">
        <span class="cc-legal__eyebrow">Traders Cup · Verão 2026</span>
        <h1 class="cc-legal__title">Termos e Condições da Traders Cup Verão 2026 da Warren Bowie &amp; Smith</h1>

        <div class="cc-legal__body" set:html={termsBody}></div>

        <a class="cc-legal__back" href={`${base}/pt/`}>← Voltar à Cup</a>
      </article>
    </main>
  </div>
</BaseLayout>
