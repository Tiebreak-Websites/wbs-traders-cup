---
// Warren Bowie & Smith Traders Cup 2026 — English route
// Order: Hero → Leaderboard → How it works (+formula) → Prizes → FAQ → Footer + sticky CTA

import BaseLayout       from '../layouts/BaseLayout.astro';
import HeroPanel        from '../components/HeroPanel.astro';
import HowItWorks       from '../components/HowItWorks.astro';
import LeaderboardCard  from '../components/LeaderboardCard.astro';
import FAQ              from '../components/FAQ.astro';
import StickyCtaBar     from '../components/StickyCtaBar.astro';
import ControlsToolbar  from '../components/ControlsToolbar.astro';
import copy from '../data/copy.en.json';
---

<BaseLayout copy={copy} locale="en">
  <div class="bt cc-page">
    <ControlsToolbar copy={copy} locale="en" />

    <main class="cc-main">
      <HeroPanel        copy={copy} />
      <LeaderboardCard  copy={copy} />
      <HowItWorks       copy={copy} />
      <FAQ              copy={copy} />
    </main>

    <StickyCtaBar copy={copy} />
  </div>
</BaseLayout>
