---
// Términos y Condiciones del Torneo — Español
// Contenido traducido del archivo oficial en inglés (la versión en inglés prevalece).
import BaseLayout      from '../../layouts/BaseLayout.astro';
import ControlsToolbar from '../../components/ControlsToolbar.astro';
import copy from '../../data/copy.es.json';
import termsBody from '../../content/terms-es.html?raw';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageTitle = 'Términos y Condiciones de la Traders Cup Verano 2026 de Warren Bowie & Smith';
---

<BaseLayout copy={copy} locale="es" title={pageTitle} description="Términos y condiciones oficiales de la Traders Cup Verano 2026 de Warren Bowie & Smith.">
  <div class="bt cc-page">
    <ControlsToolbar copy={copy} locale="es" />

    <main class="cc-main">
      <article class="cc-legal">
        <span class="cc-legal__eyebrow">Traders Cup · Verano 2026</span>
        <h1 class="cc-legal__title">Términos y Condiciones de la Traders Cup Verano 2026 de Warren Bowie &amp; Smith</h1>

        <div class="cc-legal__body" set:html={termsBody}></div>

        <a class="cc-legal__back" href={`${base}/es/`}>← Volver a la Cup</a>
      </article>
    </main>
  </div>
</BaseLayout>
