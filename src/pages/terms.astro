---
// Tournament Terms & Conditions — English (placeholder)
import BaseLayout      from '../layouts/BaseLayout.astro';
import ControlsToolbar from '../components/ControlsToolbar.astro';
import copy from '../data/copy.en.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageTitle = 'Tournament Terms & Conditions — Warren Bowie & Smith Traders Championship 2026';
---

<BaseLayout copy={copy} locale="en" title={pageTitle} description="Tournament terms and conditions for the Warren Bowie & Smith Traders Championship 2026.">
  <div class="bt cc-page">
    <ControlsToolbar copy={copy} locale="en" />

    <main class="cc-main">
      <article class="cc-legal">
        <span class="cc-legal__eyebrow">Traders Championship · 2026</span>
        <h1 class="cc-legal__title">Tournament Terms &amp; Conditions</h1>
        <p class="cc-legal__updated">Last updated: coming soon</p>

        <div class="cc-legal__body">
          <p>The full tournament terms and conditions for the Warren Bowie &amp; Smith Traders Championship 2026 are being finalised and will be published here shortly.</p>
          <p>{copy.compliance}</p>
        </div>

        <a class="cc-legal__back" href={`${base}/`}>← Back to the Championship</a>
      </article>
    </main>
  </div>
</BaseLayout>
