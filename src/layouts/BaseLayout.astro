---
import '../styles/global.css';
import enCopy from '../data/copy.en.json';

interface Props {
  title?: string;
  description?: string;
  copy?: any;
  locale?: string;
}

const {
  copy = enCopy,
  locale = copy?._meta?.locale || 'en',
  title = copy.site.title,
  description = copy.site.description,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogPath = `${base}/og-en.png`;
const faviconPath = `${base}/wbs-fav-icon.png`;
const logoSrc = `${base}/wbs-white.svg`;
const fontHref = 'https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap';
const skipLabel = copy?.a11y?.skip_to_content || 'Skip to content';
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FF861C" />
    <script is:inline>document.documentElement.classList.add('cc-loading');</script>
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogPath} />
    <meta property="og:site_name" content="Warren Bowie & Smith" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogPath} />

    <!-- Fonts: WB&S brand uses Poppins (300-800) + JetBrains Mono for tabular numerics. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontHref} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fontHref} /></noscript>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href={faviconPath} />
  </head>
  <body>
    <!-- Animated chart-grid background (sits behind the whole page) -->
    <div class="cc-bg-fx" aria-hidden="true"></div>

    <!-- Page loader: WB&S mark, 3 strokes bouncing in a staggered wave -->
    <div id="cc-loader" class="cc-loader" aria-hidden="true">
      <svg class="cc-loader__mark" viewBox="0 0 132 91" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- Stroke 1: left white slash (W's first upstroke) -->
        <path class="cc-loader__s cc-loader__s--1"
              fill="#FFFFFF"
              d="M6.70887 1.8248C13.1079 -1.91474 21.3692 0.315259 25.0596 6.79942L61.6595 71.0578C65.35 77.542 63.1493 85.913 56.7502 89.6526C50.3511 93.3921 42.0899 91.1621 38.3995 84.678L1.79953 20.4196C-1.89093 13.9354 0.309804 5.56434 6.70887 1.8248Z"/>
        <!-- Stroke 2: middle white slash (W's second upstroke) -->
        <path class="cc-loader__s cc-loader__s--2"
              fill="#FFFFFF"
              d="M46.9945 1.81796C53.3936 -1.92158 61.6548 0.308423 65.3453 6.79258L101.945 71.051C105.636 77.5351 103.435 85.9062 97.0359 89.6458C90.6368 93.3853 82.3756 91.1553 78.6851 84.6711L42.0852 20.4128C38.3947 13.9286 40.5954 5.55751 46.9945 1.81796Z"/>
        <!-- Stroke 3: orange accent (the brand "wing") -->
        <path class="cc-loader__s cc-loader__s--3"
              fill="#FF861C"
              d="M85.6936 20.9619L116.267 74.6192C130.893 66.0766 135.904 47.1044 127.474 32.2835C119.043 17.4968 100.32 12.4193 85.6936 20.9619Z"/>
      </svg>
    </div>

    <script is:inline>
      (function () {
        function done() {
          var root = document.documentElement;
          if (root.classList.contains('cc-loaded')) return;
          root.classList.remove('cc-loading');
          root.classList.add('cc-loaded');
          var el = document.getElementById('cc-loader');
          if (el) {
            el.classList.add('is-done');
            setTimeout(function () { if (el && el.parentNode) el.parentNode.removeChild(el); }, 600);
          }
          document.dispatchEvent(new CustomEvent('cc:reveal:rescan'));
        }
        if (document.readyState === 'complete') done();
        else window.addEventListener('load', done);
        setTimeout(done, 10000);
      })();
    </script>

    <a href="#main" class="skip-link">{skipLabel}</a>
    <slot />

    <!-- Scroll-position reveal -->
    <script is:inline>
      (function () {
        var revealSelector = '.reveal:not(.is-visible)';
        var ticking = false;

        function check() {
          ticking = false;
          if (!document.documentElement.classList.contains('cc-loaded')) return;
          var winH = window.innerHeight || document.documentElement.clientHeight;
          var triggerY = winH * 0.92;
          document.querySelectorAll(revealSelector).forEach(function (el) {
            var rect = el.getBoundingClientRect();
            if (rect.top < triggerY && rect.bottom > 0) {
              el.classList.add('is-visible');
            }
          });
        }

        function schedule() {
          if (ticking) return;
          ticking = true;
          setTimeout(check, 32);
        }

        window.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', schedule);
        document.addEventListener('cc:reveal:rescan', check);

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', check);
        } else {
          check();
        }
        setTimeout(check, 100);
        setTimeout(check, 400);
        setTimeout(check, 2500);
      })();
    </script>

    <script is:inline>
      (function () {
        if (!('IntersectionObserver' in window)) return;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { e.target.classList.toggle('cc-anim-off', !e.isIntersecting); });
        }, { rootMargin: '140px' });
        ['.cc-hero', '.cc-prizes'].forEach(function (sel) {
          var el = document.querySelector(sel);
          if (el) io.observe(el);
        });
      })();
    </script>

    <!-- Forward incoming tracking params (utm_*, gclid, fbclid, …) onto CTAs -->
    <script>
      import '../scripts/cta-params.js';
    </script>

    <style is:global>
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        background: var(--bt-accent);
        color: #FFFFFF;
        padding: 0.5rem 0.75rem;
        border-radius: 6px;
        font-weight: 600;
        z-index: 100;
        transition: top 0.2s ease;
        text-decoration: none;
      }
      .skip-link:focus { top: 1rem; }

      .cc-loader {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: grid;
        place-items: center;
        background: radial-gradient(60% 80% at 50% 50%, #2E3B43 0%, var(--bt-bg-0) 70%, #1E282D 100%);
        transition: opacity 0.5s ease, visibility 0.5s ease;
      }
      .cc-loader.is-done { opacity: 0; visibility: hidden; }
      .cc-loader__mark {
        width: 96px;
        height: auto;
        overflow: visible;
        filter: drop-shadow(0 14px 40px rgba(255, 134, 28, 0.45));
        animation: ccLoaderBreathe 2.2s ease-in-out infinite;
      }
      .cc-loader__s {
        transform-origin: center bottom;
        transform-box: fill-box;
        animation: ccLoaderStroke 1.5s cubic-bezier(.4, .1, .3, 1.3) infinite;
        will-change: transform, filter;
      }
      .cc-loader__s--1 { animation-delay: 0ms;   }
      .cc-loader__s--2 { animation-delay: 150ms; }
      .cc-loader__s--3 { animation-delay: 300ms; }
      /* Each stroke pops once per cycle: scale up + lift slightly + brighten,
         then settles. Sequencing creates a left-to-right wave through the
         mark, with the orange brand stroke as the climactic flash. */
      @keyframes ccLoaderStroke {
        0%, 60%, 100% {
          transform: translateY(0) scale(1);
          filter: brightness(1);
        }
        18% {
          transform: translateY(-4px) scale(1.18);
          filter: brightness(1.35) drop-shadow(0 0 12px rgba(255, 134, 28, 0.65));
        }
        38% {
          transform: translateY(0) scale(1);
          filter: brightness(1);
        }
      }
      /* Whole mark breathes gently behind the per-stroke wave */
      @keyframes ccLoaderBreathe {
        0%, 100% { transform: scale(1);    opacity: 0.95; }
        50%      { transform: scale(1.03); opacity: 1; }
      }
      html.cc-loading .cc-page *,
      html.cc-loading .cc-bg-fx,
      html.cc-loading .cc-bg-fx::before {
        animation-play-state: paused !important;
      }
      @media (prefers-reduced-motion: reduce) {
        .cc-loader__mark, .cc-loader__s { animation: none; }
      }
    </style>
  </body>
</html>
