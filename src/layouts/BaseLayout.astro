---
import '../styles/global.css';
import enCopy from '../data/copy.en.json';

interface Props {
  title?: string;
  description?: string;
  copy?: any;
}

const {
  copy = enCopy,
  title = copy.site.title,
  description = copy.site.description,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogPath = `${base}/og-en.png`;
const faviconPath = `${base}/wbs-fav-icon.png`;
const logoSrc = `${base}/wbs-white.svg`;
const fontHref = 'https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap';
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FF861C" />
    <script is:inline>document.documentElement.classList.add('cc-loading');</script>
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogPath} />
    <meta property="og:site_name" content="Warren Bowie & Smith" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogPath} />

    <!-- Fonts: WB&S brand uses Poppins (300-800) + JetBrains Mono for tabular numerics. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontHref} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fontHref} /></noscript>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href={faviconPath} />
  </head>
  <body>
    <!-- Animated chart-grid background (sits behind the whole page) -->
    <div class="cc-bg-fx" aria-hidden="true"></div>

    <!-- Page loader: branded logo focus-in, then fades away -->
    <div id="cc-loader" class="cc-loader" aria-hidden="true">
      <img class="cc-loader__logo" src={logoSrc} alt="" width="190" height="56" />
    </div>

    <script is:inline>
      (function () {
        function done() {
          var root = document.documentElement;
          if (root.classList.contains('cc-loaded')) return;
          root.classList.remove('cc-loading');
          root.classList.add('cc-loaded');
          var el = document.getElementById('cc-loader');
          if (el) {
            el.classList.add('is-done');
            setTimeout(function () { if (el && el.parentNode) el.parentNode.removeChild(el); }, 600);
          }
          document.dispatchEvent(new CustomEvent('cc:reveal:rescan'));
        }
        if (document.readyState === 'complete') done();
        else window.addEventListener('load', done);
        setTimeout(done, 10000);
      })();
    </script>

    <a href="#main" class="skip-link">Skip to content</a>
    <slot />

    <!-- Scroll-position reveal -->
    <script is:inline>
      (function () {
        var revealSelector = '.reveal:not(.is-visible)';
        var ticking = false;

        function check() {
          ticking = false;
          if (!document.documentElement.classList.contains('cc-loaded')) return;
          var winH = window.innerHeight || document.documentElement.clientHeight;
          var triggerY = winH * 0.92;
          document.querySelectorAll(revealSelector).forEach(function (el) {
            var rect = el.getBoundingClientRect();
            if (rect.top < triggerY && rect.bottom > 0) {
              el.classList.add('is-visible');
            }
          });
        }

        function schedule() {
          if (ticking) return;
          ticking = true;
          setTimeout(check, 32);
        }

        window.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', schedule);
        document.addEventListener('cc:reveal:rescan', check);

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', check);
        } else {
          check();
        }
        setTimeout(check, 100);
        setTimeout(check, 400);
        setTimeout(check, 2500);
      })();
    </script>

    <script is:inline>
      (function () {
        if (!('IntersectionObserver' in window)) return;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { e.target.classList.toggle('cc-anim-off', !e.isIntersecting); });
        }, { rootMargin: '140px' });
        ['.cc-hero', '.cc-prizes'].forEach(function (sel) {
          var el = document.querySelector(sel);
          if (el) io.observe(el);
        });
      })();
    </script>

    <style is:global>
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        background: var(--bt-accent);
        color: #FFFFFF;
        padding: 0.5rem 0.75rem;
        border-radius: 6px;
        font-weight: 600;
        z-index: 100;
        transition: top 0.2s ease;
        text-decoration: none;
      }
      .skip-link:focus { top: 1rem; }

      .cc-loader {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: grid;
        place-items: center;
        background: var(--bt-bg-0);
        transition: opacity 0.5s ease, visibility 0.5s ease;
      }
      .cc-loader.is-done { opacity: 0; visibility: hidden; }
      .cc-loader__logo {
        width: 190px;
        height: auto;
        opacity: 0;
        transform: scale(0.92);
        filter: blur(10px);
        animation: ccLoaderLogo 1.6s ease-in-out infinite alternate;
      }
      @keyframes ccLoaderLogo {
        0%   { opacity: 0.55; transform: scale(0.94); filter: blur(6px); }
        100% { opacity: 1;    transform: scale(1);    filter: blur(0); }
      }
      html.cc-loading .cc-page *,
      html.cc-loading .cc-bg-fx,
      html.cc-loading .cc-bg-fx::before {
        animation-play-state: paused !important;
      }
      @media (prefers-reduced-motion: reduce) {
        .cc-loader__logo { animation: none; opacity: 1; transform: none; filter: none; }
      }
    </style>
  </body>
</html>
