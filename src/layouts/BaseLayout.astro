---
import '../styles/global.css';
import enCopy from '../data/copy.en.json';

interface Props {
  title?: string;
  description?: string;
  copy?: any;
  locale?: 'en' | 'ar';
}

const {
  copy = enCopy,
  locale = (copy?._meta?.locale === 'ar' ? 'ar' : 'en'),
  title = copy.site.title,
  description = copy.site.description,
} = Astro.props;

const dir = locale === 'ar' ? 'rtl' : 'ltr';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogPath = `${base}${locale === 'ar' ? '/og-ar.png' : '/og-en.png'}`;
const faviconPath = `${base}/wbs-fav-icon.png`;
const logoSrc = `${base}/wbs-white.svg`;
const skipLabel = locale === 'ar' ? 'انتقل إلى المحتوى' : 'Skip to content';
// Only load the fonts each locale actually needs (lighter critical path).
// WB&S brand: Poppins single-typeface system (300-800).
const fontHref = locale === 'ar'
  ? 'https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700;800&display=swap'
  : 'https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap';
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FF861C" />
    <script is:inline>document.documentElement.classList.add('cc-loading');</script>
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogPath} />
    <meta property="og:site_name" content="Warren Bowie & Smith" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogPath} />

    <!-- Fonts: WB&S brand uses Poppins (Latin). Arabic also loads IBM Plex Sans Arabic.
         Loaded non-render-blocking; display=swap shows fallback text immediately. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontHref} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fontHref} /></noscript>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href={faviconPath} />
  </head>
  <body>
    <!-- Animated chart-grid background (sits behind the whole page) -->
    <div class="cc-bg-fx" aria-hidden="true"></div>

    <!-- Page loader: branded logo focus-in, then fades away -->
    <div id="cc-loader" class="cc-loader" aria-hidden="true">
      <img class="cc-loader__logo" src={logoSrc} alt="" width="190" height="56" />
    </div>

    <script is:inline>
      (function () {
        // Hide on the REAL page load (all images/fonts ready), not a fixed timer.
        // Then un-gate the page so reveal + loop animations start playing.
        function done() {
          var root = document.documentElement;
          if (root.classList.contains('cc-loaded')) return;
          root.classList.remove('cc-loading');
          root.classList.add('cc-loaded');
          var el = document.getElementById('cc-loader');
          if (el) {
            el.classList.add('is-done');
            setTimeout(function () { if (el && el.parentNode) el.parentNode.removeChild(el); }, 600);
          }
          // Kick the reveal observer now that the page is allowed to animate.
          document.dispatchEvent(new CustomEvent('cc:reveal:rescan'));
        }
        if (document.readyState === 'complete') done();
        else window.addEventListener('load', done);
        // Safety net only — in case a resource stalls and 'load' never fires.
        setTimeout(done, 10000);
      })();
    </script>

    <a href="#main" class="skip-link">{skipLabel}</a>
    <slot />

    <!-- Scroll-position reveal — adds .is-visible to .reveal elements when they
         enter the viewport. Triggers on load, scroll, and resize. -->
    <script is:inline>
      (function () {
        var revealSelector = '.reveal:not(.is-visible)';
        var ticking = false;

        function check() {
          ticking = false;
          // Hold all reveals until the loader has finished.
          if (!document.documentElement.classList.contains('cc-loaded')) return;
          var winH = window.innerHeight || document.documentElement.clientHeight;
          // Trigger when element's top is within ~92% of the viewport — gives a
          // small "pre-load" margin so animations start just before the element
          // fully enters view.
          var triggerY = winH * 0.92;
          document.querySelectorAll(revealSelector).forEach(function (el) {
            var rect = el.getBoundingClientRect();
            if (rect.top < triggerY && rect.bottom > 0) {
              el.classList.add('is-visible');
            }
          });
        }

        function schedule() {
          if (ticking) return;
          ticking = true;
          // setTimeout instead of rAF — some embedded browsers don't tick rAF.
          setTimeout(check, 32);
        }

        window.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', schedule);
        document.addEventListener('cc:reveal:rescan', check);

        // Initial check — runs as soon as the DOM is parsed.
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', check);
        } else {
          check();
        }
        // Belt-and-suspenders: run a few more checks just after load in case
        // images/fonts shift the layout and put elements over the trigger line.
        setTimeout(check, 100);
        setTimeout(check, 400);

        // Safety net: if for any reason scroll/raf don't fire (some embedded
        // browsers), make sure elements currently in the viewport are revealed.
        // Below-the-fold elements STAY hidden until user scrolls to them — we
        // do NOT force them visible (that would defeat the scroll-trigger UX).
        setTimeout(check, 2500);
      })();
    </script>

    <!-- Pause looping animations in sections that aren't on screen (saves CPU/GPU) -->
    <script is:inline>
      (function () {
        if (!('IntersectionObserver' in window)) return;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { e.target.classList.toggle('cc-anim-off', !e.isIntersecting); });
        }, { rootMargin: '140px' });
        ['.cc-hero', '.cc-prizes'].forEach(function (sel) {
          var el = document.querySelector(sel);
          if (el) io.observe(el);
        });
      })();
    </script>

    <style is:global>
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        background: var(--bt-accent);
        color: #FFFFFF;
        padding: 0.5rem 0.75rem;
        border-radius: 6px;
        font-weight: 600;
        z-index: 100;
        transition: top 0.2s ease;
        text-decoration: none;
      }
      .skip-link:focus { top: 1rem; }

      /* Page loader — branded logo focus-in, then the overlay fades away */
      .cc-loader {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: grid;
        place-items: center;
        background: var(--bt-bg-0);
        transition: opacity 0.5s ease, visibility 0.5s ease;
      }
      .cc-loader.is-done { opacity: 0; visibility: hidden; }
      .cc-loader__logo {
        width: 190px;
        height: auto;
        opacity: 0;
        transform: scale(0.92);
        filter: blur(10px);
        /* Gentle pulsing focus-in that loops while the real page is loading */
        animation: ccLoaderLogo 1.6s ease-in-out infinite alternate;
      }
      @keyframes ccLoaderLogo {
        0%   { opacity: 0.55; transform: scale(0.94); filter: blur(6px); }
        100% { opacity: 1;    transform: scale(1);    filter: blur(0); }
      }
      /* Hold the page's animations until the loader finishes, then let them play */
      html.cc-loading .cc-page *,
      html.cc-loading .cc-bg-fx,
      html.cc-loading .cc-bg-fx::before {
        animation-play-state: paused !important;
      }
      @media (prefers-reduced-motion: reduce) {
        .cc-loader__logo { animation: none; opacity: 1; transform: none; filter: none; }
      }
    </style>
  </body>
</html>
